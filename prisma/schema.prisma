// Tracklibute — Foundation schema.
//
// Conventions:
// - Every tenant-owned table carries `organization_id` and is protected by
//   PostgreSQL Row-Level Security (see the `rls_and_guards` migration).
// - `users` is the only global table: a user can belong to several organizations.
// - Email context is owner-private; CRM context and the content-free
//   EmailActivity layer are organization-readable (Build Spec 03).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Identity & organization ───────────────────────────────────────────────

model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  members            OrganizationMember[]
  sessions           Session[]
  integrations       Integration[]
  responsibilities   Responsibility[]
  responsibilityRuns ResponsibilityRun[]
  recommendations    Recommendation[]
  proposedActions    ProposedAction[]
  approvals          Approval[]
  auditLogs          AuditLog[]

  // Domains whose addresses count as teammates, never as buyers (EmailActivity).
  internalEmailDomains      String[] @default([]) @map("internal_email_domains")
  // Bumped when the rules above change; mailboxes rebuild their EmailActivity.
  emailActivityRulesVersion Int      @default(1) @map("email_activity_rules_version")

  @@map("organizations")
}

model User {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String   @unique
  name          String?
  // Stable Google account identifier (OIDC `sub`). Identity is keyed on this, not on email.
  googleSubject String?  @unique @map("google_subject")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships OrganizationMember[]
  sessions    Session[]

  @@map("users")
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER

  @@map("member_role")
}

model OrganizationMember {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  userId         String     @map("user_id") @db.Uuid
  role           MemberRole @default(MEMBER)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  ownedIntegrations Integration[]     @relation("IntegrationOwner")
  crmOwnerMappings  CrmOwnerMapping[]

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

// Database-backed opaque sessions. The client holds a random token; only its
// HMAC is stored. Reachable by the app role exclusively through SECURITY
// DEFINER auth_* functions (no table grants).
model Session {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  userId         String    @map("user_id") @db.Uuid
  // Null until the user creates (or is bound to) an organization.
  organizationId String?   @map("organization_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ─── Integrations ──────────────────────────────────────────────────────────

enum IntegrationProvider {
  GMAIL
  HUBSPOT
  GOOGLE_CALENDAR

  @@map("integration_provider")
}

enum IntegrationStatus {
  PENDING
  CONNECTED
  ERROR
  REAUTH_REQUIRED
  DISCONNECTED

  @@map("integration_status")
}

model Integration {
  id                     String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String              @map("organization_id") @db.Uuid
  provider               IntegrationProvider
  status                 IntegrationStatus   @default(PENDING)
  // Provider-side account identifier (mailbox address, HubSpot portal id, ...).
  externalAccountId      String?             @map("external_account_id")
  scopes                 String[]            @default([])
  // AES-256-GCM envelope. Never selected into client-facing DTOs.
  encryptedCredentials   String?             @map("encrypted_credentials")
  connectedByUserId      String?             @map("connected_by_user_id") @db.Uuid
  // Set for user-scoped integrations (a personal mailbox). Null for org-wide
  // integrations (e.g. a CRM portal). Removing the member removes the mailbox.
  ownerUserId            String?             @map("owner_user_id") @db.Uuid
  tokenExpiresAt         DateTime?           @map("token_expires_at") @db.Timestamptz(3)
  lastSyncAttemptAt      DateTime?           @map("last_sync_attempt_at") @db.Timestamptz(3)
  lastSyncedAt           DateTime?           @map("last_synced_at") @db.Timestamptz(3)
  // Provider sync checkpoint (Gmail historyId). Advanced only after a successful sync.
  syncCursor             String?             @map("sync_cursor")
  // Checkpoint captured when a multi-run initial backfill STARTED. Becomes
  // syncCursor when the backfill completes, so changes during a long backfill
  // are replayed by the first incremental sync. Null when no backfill is pending.
  backfillCursor         String?             @map("backfill_cursor")
  // Concurrency lease: a sync may run only while it holds an unexpired lease.
  syncLeaseExpiresAt     DateTime?           @map("sync_lease_expires_at") @db.Timestamptz(3)
  lastError              String?             @map("last_error")
  // CRM: when the last complete full reconcile pass started (HubSpot).
  fullSyncedAt           DateTime?           @map("full_synced_at") @db.Timestamptz(3)
  // CRM: whether pipeline/stage metadata could be read on the last sync
  // ('OK' | 'UNAVAILABLE'; null = never attempted) and a safe reason code.
  pipelineMetadataStatus String?             @map("pipeline_metadata_status")
  pipelineMetadataError  String?             @map("pipeline_metadata_error")
  // Mailbox: EmailActivity rules version this mailbox was derived with (0 = never).
  emailActivityVersion   Int                 @default(0) @map("email_activity_version")
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner             OrganizationMember? @relation("IntegrationOwner", fields: [organizationId, ownerUserId], references: [organizationId, userId], onDelete: Cascade)
  emailThreads      EmailThread[]
  emailMessages     EmailMessage[]
  emailActivities   EmailActivity[]
  crmOwners         CrmOwner[]
  crmPipelineStages CrmPipelineStage[]
  crmCompanies      CrmCompany[]
  crmContacts       CrmContact[]
  crmDeals          CrmDeal[]

  // Org-wide rows (owner_user_id IS NULL) are also unique per provider: a
  // partial unique index in the spec03 migration (NULLs are distinct here).
  @@unique([organizationId, provider, externalAccountId])
  @@unique([organizationId, provider, ownerUserId])
  @@unique([organizationId, id, ownerUserId])
  @@unique([organizationId, id])
  @@index([organizationId, provider])
  @@map("integrations")
}

// ─── Responsibilities (core abstraction) ───────────────────────────────────

enum ResponsibilityType {
  SYSTEM
  CUSTOM

  @@map("responsibility_type")
}

enum ResponsibilityStatus {
  ACTIVE
  PAUSED
  ARCHIVED

  @@map("responsibility_status")
}

model Responsibility {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  name           String
  description    String
  type           ResponsibilityType
  // Set for SYSTEM responsibilities (e.g. "lead_health"); null for CUSTOM.
  templateKey    String?              @map("template_key")
  status         ResponsibilityStatus @default(ACTIVE)
  ownerUserId    String?              @map("owner_user_id") @db.Uuid
  config         Json                 @default("{}")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs            ResponsibilityRun[]
  recommendations Recommendation[]

  @@unique([organizationId, id])
  @@unique([organizationId, templateKey])
  @@index([organizationId, status])
  @@map("responsibilities")
}

enum ResponsibilityRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED

  @@map("responsibility_run_status")
}

model ResponsibilityRun {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String                  @map("organization_id") @db.Uuid
  responsibilityId String                  @map("responsibility_id") @db.Uuid
  status           ResponsibilityRunStatus @default(QUEUED)
  startedAt        DateTime?               @map("started_at") @db.Timestamptz(3)
  finishedAt       DateTime?               @map("finished_at") @db.Timestamptz(3)
  summary          Json?
  error            String?
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  responsibility  Responsibility   @relation(fields: [organizationId, responsibilityId], references: [organizationId, id], onDelete: Cascade)
  recommendations Recommendation[]

  @@unique([organizationId, id])
  @@index([organizationId, responsibilityId, createdAt])
  @@map("responsibility_runs")
}

// ─── Recommendations → Proposed actions → Approvals ────────────────────────

enum RecommendationSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("recommendation_severity")
}

enum RecommendationStatus {
  OPEN
  ACCEPTED
  DISMISSED
  SNOOZED
  RESOLVED

  @@map("recommendation_status")
}

model Recommendation {
  id                  String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String                 @map("organization_id") @db.Uuid
  responsibilityId    String                 @map("responsibility_id") @db.Uuid
  responsibilityRunId String?                @map("responsibility_run_id") @db.Uuid
  title               String
  summary             String
  severity            RecommendationSeverity @default(MEDIUM)
  status              RecommendationStatus   @default(OPEN)
  // Opaque pointer to the external record this is about, e.g.
  // { "provider": "HUBSPOT", "kind": "deal", "externalId": "123" }.
  // Normalized sales-context models replace this in a later spec.
  subjectRef          Json?                  @map("subject_ref")
  evidence            Json?
  snoozedUntil        DateTime?              @map("snoozed_until") @db.Timestamptz(3)
  // Deduplication: one row per (responsibility, dedupe key), forever. Detectors
  // update / resolve / reopen it instead of creating duplicates.
  dedupeKey           String?                @map("dedupe_key")
  // Detector state + reason codes the current status was decided on.
  fingerprint         String?
  dealId              String?                @map("deal_id") @db.Uuid
  lastDetectedAt      DateTime?              @map("last_detected_at") @db.Timestamptz(3)
  resolvedAt          DateTime?              @map("resolved_at") @db.Timestamptz(3)
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  responsibility    Responsibility     @relation(fields: [organizationId, responsibilityId], references: [organizationId, id], onDelete: Cascade)
  responsibilityRun ResponsibilityRun? @relation(fields: [organizationId, responsibilityRunId], references: [organizationId, id], onDelete: NoAction)
  // NoAction: services null deal_id before CRM data is deleted (history is kept).
  deal              CrmDeal?           @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: NoAction, map: "recommendations_deal_fkey")
  proposedActions   ProposedAction[]

  @@unique([organizationId, id])
  @@unique([organizationId, responsibilityId, dedupeKey])
  @@index([organizationId, status])
  @@index([organizationId, dealId])
  @@map("recommendations")
}

enum ProposedActionStatus {
  PROPOSED
  APPROVED
  REJECTED
  EXECUTING
  EXECUTED
  FAILED
  CANCELLED

  @@map("proposed_action_status")
}

enum ActionSource {
  SYSTEM
  AI
  USER

  @@map("action_source")
}

model ProposedAction {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String               @map("organization_id") @db.Uuid
  recommendationId String?              @map("recommendation_id") @db.Uuid
  // Key into the closed ActionRegistry (e.g. "gmail.send_email").
  actionType       String               @map("action_type")
  payload          Json
  // Copied from the registry at creation; immutable afterwards (DB-enforced).
  requiresApproval Boolean              @map("requires_approval")
  status           ProposedActionStatus @default(PROPOSED)
  source           ActionSource
  createdByUserId  String?              @map("created_by_user_id") @db.Uuid
  result           Json?
  error            String?
  executedAt       DateTime?            @map("executed_at") @db.Timestamptz(3)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recommendation Recommendation? @relation(fields: [organizationId, recommendationId], references: [organizationId, id], onDelete: NoAction)
  approval       Approval?

  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@map("proposed_actions")
}

enum ApprovalDecision {
  APPROVED
  REJECTED

  @@map("approval_decision")
}

// One immutable decision per proposed action (DB-enforced: unique + no UPDATE/DELETE).
model Approval {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  proposedActionId String           @unique @map("proposed_action_id") @db.Uuid
  decision         ApprovalDecision
  decidedByUserId  String           @map("decided_by_user_id") @db.Uuid
  reason           String?
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  proposedAction ProposedAction @relation(fields: [organizationId, proposedActionId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, proposedActionId])
  @@map("approvals")
}

// ─── Audit (append-only, DB-enforced) ──────────────────────────────────────

enum ActorType {
  USER
  SYSTEM

  @@map("actor_type")
}

model AuditLog {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  actorType      ActorType @map("actor_type")
  actorUserId    String?   @map("actor_user_id") @db.Uuid
  event          String
  entityType     String    @map("entity_type")
  entityId       String?   @map("entity_id")
  metadata       Json?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@map("audit_logs")
}

// ─── Normalized email context (owner-private) ──────────────────────────────
//
// Provider-neutral representation of synced mail. Gmail ids are stored only
// as external identifiers. Every row carries (organization_id,
// mailbox_user_id); RLS restricts all four tables to the mailbox owner.

enum EmailDirection {
  INBOUND
  OUTBOUND
  UNKNOWN

  @@map("email_direction")
}

enum EmailRecipientKind {
  TO
  CC
  BCC

  @@map("email_recipient_kind")
}

model EmailThread {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  mailboxUserId    String   @map("mailbox_user_id") @db.Uuid
  integrationId    String   @map("integration_id") @db.Uuid
  externalThreadId String   @map("external_thread_id")
  subject          String?
  firstMessageAt   DateTime @map("first_message_at") @db.Timestamptz(3)
  lastMessageAt    DateTime @map("last_message_at") @db.Timestamptz(3)
  messageCount     Int      @default(0) @map("message_count")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Composite FK guarantees the thread's owner IS the integration's owner.
  integration Integration    @relation(fields: [organizationId, integrationId, mailboxUserId], references: [organizationId, id, ownerUserId], onDelete: Cascade, map: "email_threads_integration_owner_fkey")
  messages    EmailMessage[]

  @@unique([integrationId, externalThreadId])
  @@unique([organizationId, integrationId, mailboxUserId, id])
  @@index([organizationId, mailboxUserId, lastMessageAt(sort: Desc), id])
  @@map("email_threads")
}

model EmailMessage {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String         @map("organization_id") @db.Uuid
  mailboxUserId     String         @map("mailbox_user_id") @db.Uuid
  integrationId     String         @map("integration_id") @db.Uuid
  threadId          String         @map("thread_id") @db.Uuid
  externalMessageId String         @map("external_message_id")
  externalThreadId  String         @map("external_thread_id")
  fromEmail         String?        @map("from_email")
  fromName          String?        @map("from_name")
  subject           String?
  snippet           String?
  // Normalized plain text, capped (see EMAIL_BODY_MAX_CHARS). Untrusted content.
  bodyText          String?        @map("body_text")
  bodyTruncated     Boolean        @default(false) @map("body_truncated")
  sentAt            DateTime?      @map("sent_at") @db.Timestamptz(3)
  receivedAt        DateTime       @map("received_at") @db.Timestamptz(3)
  direction         EmailDirection
  // Allow-listed system labels only (INBOX, SENT, IMPORTANT, ...).
  labels            String[]       @default([])
  // Allow-listed normalized header metadata (message-id, in-reply-to, list-id, ...).
  headers           Json?
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  integration Integration             @relation(fields: [organizationId, integrationId, mailboxUserId], references: [organizationId, id, ownerUserId], onDelete: Cascade, map: "email_messages_integration_owner_fkey")
  thread      EmailThread             @relation(fields: [organizationId, integrationId, mailboxUserId, threadId], references: [organizationId, integrationId, mailboxUserId, id], onDelete: Cascade, map: "email_messages_thread_owner_fkey")
  recipients  EmailMessageRecipient[]

  @@unique([integrationId, externalMessageId])
  @@unique([organizationId, mailboxUserId, id])
  @@index([threadId, receivedAt])
  @@index([organizationId, mailboxUserId, receivedAt])
  @@map("email_messages")
}

model EmailMessageRecipient {
  organizationId String             @map("organization_id") @db.Uuid
  mailboxUserId  String             @map("mailbox_user_id") @db.Uuid
  messageId      String             @map("message_id") @db.Uuid
  kind           EmailRecipientKind
  // Lowercased address; the comparison key.
  email          String
  name           String?

  message EmailMessage @relation(fields: [organizationId, mailboxUserId, messageId], references: [organizationId, mailboxUserId, id], onDelete: Cascade)

  @@id([messageId, kind, email])
  @@index([organizationId, mailboxUserId, email])
  @@map("email_message_recipients")
}

// ─── Content-free email activity (organization-readable) ───────────────────
//
// Derived from owner-private mail during sync. Metadata ONLY: who on the team
// exchanged mail with which external address, in which direction, when.
// No subject, snippet, body, labels or display names — by construction.
// Readable by every member of the organization; written / deleted only by the
// mailbox owner's own sync (RLS).

model EmailActivity {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String         @map("organization_id") @db.Uuid
  integrationId     String         @map("integration_id") @db.Uuid
  mailboxUserId     String         @map("mailbox_user_id") @db.Uuid
  // Opaque Gmail ids: idempotency / deletion key and thread reference only.
  externalMessageId String         @map("external_message_id")
  externalThreadId  String         @map("external_thread_id")
  direction         EmailDirection
  counterpartEmail  String         @map("counterpart_email")
  counterpartDomain String         @map("counterpart_domain")
  occurredAt        DateTime       @map("occurred_at") @db.Timestamptz(3)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  integration Integration @relation(fields: [organizationId, integrationId, mailboxUserId], references: [organizationId, id, ownerUserId], onDelete: Cascade, map: "email_activities_integration_owner_fkey")

  @@unique([organizationId, mailboxUserId, externalMessageId, counterpartEmail])
  @@index([organizationId, counterpartEmail, occurredAt])
  @@index([organizationId, counterpartDomain, occurredAt])
  @@index([integrationId, externalMessageId])
  @@map("email_activities")
}

// ─── Normalized CRM context (organization-readable, read-only mirror) ──────
//
// Mirrors only what Opportunity Health needs from HubSpot. Tracklibute never
// writes back to the CRM. Records are keyed by (organization, integration,
// external id); provider ids are external identifiers only.

enum CrmOwnerMappingSource {
  AUTO_EMAIL
  MANUAL

  @@map("crm_owner_mapping_source")
}

enum OpportunityHealthState {
  HEALTHY
  NEEDS_ATTENTION
  AT_RISK

  @@map("opportunity_health_state")
}

model CrmOwner {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  integrationId  String   @map("integration_id") @db.Uuid
  externalId     String   @map("external_id")
  email          String?
  firstName      String?  @map("first_name")
  lastName       String?  @map("last_name")
  archived       Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  integration Integration      @relation(fields: [organizationId, integrationId], references: [organizationId, id], onDelete: Cascade, map: "crm_owners_integration_fkey")
  mapping     CrmOwnerMapping?

  @@unique([organizationId, id])
  @@unique([organizationId, integrationId, externalId])
  @@map("crm_owners")
}

/// HubSpot owner → Tracklibute organization member.
model CrmOwnerMapping {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String                @map("organization_id") @db.Uuid
  crmOwnerId      String                @map("crm_owner_id") @db.Uuid
  userId          String                @map("user_id") @db.Uuid
  source          CrmOwnerMappingSource
  createdByUserId String?               @map("created_by_user_id") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  crmOwner CrmOwner           @relation(fields: [organizationId, crmOwnerId], references: [organizationId, id], onDelete: Cascade, map: "crm_owner_mappings_owner_fkey")
  // Removing the member removes the mapping.
  member   OrganizationMember @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade, map: "crm_owner_mappings_member_fkey")

  @@unique([organizationId, crmOwnerId])
  @@index([organizationId, userId])
  @@map("crm_owner_mappings")
}

model CrmPipelineStage {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  integrationId      String   @map("integration_id") @db.Uuid
  pipelineExternalId String   @map("pipeline_external_id")
  pipelineLabel      String   @map("pipeline_label")
  externalId         String   @map("external_id")
  label              String
  displayOrder       Int      @default(0) @map("display_order")
  // Null when HubSpot's stage metadata did not state whether the stage is closed.
  isClosed           Boolean? @map("is_closed")
  isWon              Boolean? @map("is_won")
  probability        Decimal? @db.Decimal(5, 4)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  integration Integration @relation(fields: [organizationId, integrationId], references: [organizationId, id], onDelete: Cascade, map: "crm_pipeline_stages_integration_fkey")

  @@unique([organizationId, integrationId, pipelineExternalId, externalId])
  @@map("crm_pipeline_stages")
}

model CrmCompany {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  integrationId     String    @map("integration_id") @db.Uuid
  externalId        String    @map("external_id")
  name              String?
  // Lowercased host, no scheme / www.
  domain            String?
  archivedAt        DateTime? @map("archived_at") @db.Timestamptz(3)
  externalUpdatedAt DateTime? @map("external_updated_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  integration Integration      @relation(fields: [organizationId, integrationId], references: [organizationId, id], onDelete: Cascade, map: "crm_companies_integration_fkey")
  deals       CrmDealCompany[]

  @@unique([organizationId, id])
  @@unique([organizationId, integrationId, externalId])
  @@index([organizationId, domain])
  @@map("crm_companies")
}

model CrmContact {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  integrationId     String    @map("integration_id") @db.Uuid
  externalId        String    @map("external_id")
  // Lowercased address — the EmailActivity match key.
  email             String?
  firstName         String?   @map("first_name")
  lastName          String?   @map("last_name")
  archivedAt        DateTime? @map("archived_at") @db.Timestamptz(3)
  externalUpdatedAt DateTime? @map("external_updated_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  integration Integration      @relation(fields: [organizationId, integrationId], references: [organizationId, id], onDelete: Cascade, map: "crm_contacts_integration_fkey")
  deals       CrmDealContact[]

  @@unique([organizationId, id])
  @@unique([organizationId, integrationId, externalId])
  @@index([organizationId, email])
  @@map("crm_contacts")
}

model CrmDeal {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  integrationId      String    @map("integration_id") @db.Uuid
  externalId         String    @map("external_id")
  name               String
  amount             Decimal?  @db.Decimal(18, 2)
  currency           String?
  // Joined at read time (no FK ordering dependency on owners / stages).
  pipelineExternalId String?   @map("pipeline_external_id")
  stageExternalId    String?   @map("stage_external_id")
  ownerExternalId    String?   @map("owner_external_id")
  // Null = open/closed status unknown (stage metadata unavailable and HubSpot's
  // hs_is_closed not provided). Such deals are never evaluated as open.
  isClosed           Boolean?  @map("is_closed")
  isWon              Boolean?  @map("is_won")
  closeDate          DateTime? @map("close_date") @db.Timestamptz(3)
  externalCreatedAt  DateTime? @map("external_created_at") @db.Timestamptz(3)
  // hs_lastmodifieddate — the incremental sync watermark.
  externalUpdatedAt  DateTime? @map("external_updated_at") @db.Timestamptz(3)
  // notes_last_updated: last CRM-logged activity (calls, meetings, notes, ...).
  crmLastActivityAt  DateTime? @map("crm_last_activity_at") @db.Timestamptz(3)
  // notes_last_contacted
  crmLastContactedAt DateTime? @map("crm_last_contacted_at") @db.Timestamptz(3)
  // notes_next_activity_date
  nextActivityAt     DateTime? @map("next_activity_at") @db.Timestamptz(3)
  archivedAt         DateTime? @map("archived_at") @db.Timestamptz(3)
  lastSeenFullSyncAt DateTime? @map("last_seen_full_sync_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  integration     Integration        @relation(fields: [organizationId, integrationId], references: [organizationId, id], onDelete: Cascade, map: "crm_deals_integration_fkey")
  contacts        CrmDealContact[]
  companies       CrmDealCompany[]
  health          OpportunityHealth?
  recommendations Recommendation[]

  @@unique([organizationId, id])
  @@unique([organizationId, integrationId, externalId])
  @@index([organizationId, isClosed, archivedAt])
  @@map("crm_deals")
}

model CrmDealContact {
  organizationId String @map("organization_id") @db.Uuid
  dealId         String @map("deal_id") @db.Uuid
  contactId      String @map("contact_id") @db.Uuid

  deal    CrmDeal    @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Cascade, map: "crm_deal_contacts_deal_fkey")
  contact CrmContact @relation(fields: [organizationId, contactId], references: [organizationId, id], onDelete: Cascade, map: "crm_deal_contacts_contact_fkey")

  @@id([dealId, contactId])
  @@index([organizationId, contactId])
  @@map("crm_deal_contacts")
}

model CrmDealCompany {
  organizationId String @map("organization_id") @db.Uuid
  dealId         String @map("deal_id") @db.Uuid
  companyId      String @map("company_id") @db.Uuid

  deal    CrmDeal    @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Cascade, map: "crm_deal_companies_deal_fkey")
  company CrmCompany @relation(fields: [organizationId, companyId], references: [organizationId, id], onDelete: Cascade, map: "crm_deal_companies_company_fkey")

  @@id([dealId, companyId])
  @@index([organizationId, companyId])
  @@map("crm_deal_companies")
}

/// Latest deterministic Opportunity Health evaluation for an open deal.
model OpportunityHealth {
  id                  String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String                 @map("organization_id") @db.Uuid
  dealId              String                 @map("deal_id") @db.Uuid
  responsibilityRunId String?                @map("responsibility_run_id") @db.Uuid
  state               OpportunityHealthState
  // Metadata-only evidence (see src/domain/opportunity-health/evidence.ts).
  reasons             Json
  evaluatedAt         DateTime               @map("evaluated_at") @db.Timestamptz(3)
  stateChangedAt      DateTime               @map("state_changed_at") @db.Timestamptz(3)

  deal CrmDeal @relation(fields: [organizationId, dealId], references: [organizationId, id], onDelete: Cascade, map: "opportunity_health_deal_fkey")

  @@unique([organizationId, dealId])
  @@index([organizationId, state])
  @@map("opportunity_health")
}
