# ── Database ────────────────────────────────────────────────────────────────
# Runtime connection: restricted role, NOT superuser, NOT BYPASSRLS, NOT table owner.
DATABASE_URL="postgresql://tracklibute_app:tracklibute_app_dev@localhost:5432/tracklibute_dev"
# Schema-owner connection: used ONLY by migrations, seed and test fixtures.
DATABASE_OWNER_URL="postgresql://tracklibute_owner:tracklibute_owner_dev@localhost:5432/tracklibute_dev"

# ── Secrets (dev values only; production: managed secret store / KMS) ───────
# AES-256-GCM key for integration credentials. 32 random bytes, base64:
#   openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=""
# Keys session-token hashing, dev-token signing and OAuth state cookies. >= 32 chars:
#   openssl rand -base64 48
# Rotating it signs everyone out.
SESSION_SECRET=""

# ── Google OAuth (one OAuth client, two redirect URIs) ──────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web application).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Sign-in callback (identity only: openid email profile)
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
# Gmail connect callback (gmail.readonly, offline access)
GMAIL_REDIRECT_URI="http://localhost:3000/api/integrations/gmail/callback"

# ── Gmail sync ──────────────────────────────────────────────────────────────
# Bearer secret for POST /api/internal/cron/gmail-sync. >= 32 chars:
#   openssl rand -hex 32
GMAIL_SYNC_CRON_SECRET=""
# Initial / recovery backfill window in days (1–365).
GMAIL_SYNC_LOOKBACK_DAYS="90"
# Pacing: Gmail quota units/second per mailbox (Google limit: 6,000/min/user = 100/s).
# messages.get costs 20 units, so 80 => ~4 messages/second (~240/minute).
GMAIL_QUOTA_UNITS_PER_SECOND="80"
# Max seconds per sync run. Larger initial backfills resume on the next run
# (cron or "Sync now"). Keep below your platform's request time limit.
GMAIL_SYNC_RUN_BUDGET_SECONDS="210"

# ── Development authentication ──────────────────────────────────────────────
# Dev sign-in is refused whenever NODE_ENV=production, regardless of this flag.
DEV_AUTH_ENABLED="true"

# ── HubSpot (read-only CRM; org-wide, connected by an ADMIN) ────────────────
# HubSpot app with ONLY these scopes: oauth crm.objects.deals.read
#   crm.objects.contacts.read crm.objects.companies.read crm.objects.owners.read
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:3000/api/integrations/hubspot/callback
# Pacing (HubSpot allows 110 requests / 10 s per installed app).
HUBSPOT_REQUESTS_PER_10S=90
HUBSPOT_SYNC_RUN_BUDGET_SECONDS=240

# ── Spec 03 cron endpoints ──────────────────────────────────────────────────
# Bearer secret for POST /api/internal/cron/hubspot-sync and
# POST /api/internal/cron/opportunity-health. >= 32 chars:
#   openssl rand -hex 32
CRON_SECRET=
