# ── Database ────────────────────────────────────────────────────────────────
# Runtime connection: restricted role, NOT superuser, NOT BYPASSRLS, NOT table owner.
DATABASE_URL="postgresql://tracklibute_app:tracklibute_app_dev@localhost:5432/tracklibute_dev"
# Schema-owner connection: used ONLY by migrations, seed and test fixtures.
DATABASE_OWNER_URL="postgresql://tracklibute_owner:tracklibute_owner_dev@localhost:5432/tracklibute_dev"

# ── Credential encryption (AES-256-GCM) ─────────────────────────────────────
# 32 random bytes, base64. Generate: openssl rand -base64 32
# Dev only. Production must load this from a managed secret store / KMS.
CREDENTIALS_ENCRYPTION_KEY=""

# ── Development authentication ──────────────────────────────────────────────
# Signs dev session tokens (HMAC-SHA256). >= 32 chars. Generate: openssl rand -base64 48
AUTH_SESSION_SECRET=""
# Dev auth provider is refused when NODE_ENV=production regardless of this flag.
DEV_AUTH_ENABLED="true"
